DATABASE_URL=            # Neon pooled connection string
GEMINI_API_KEY=
GEMINI_API_KEYS=          # optional: comma-separated extra keys, rotated with failover
GEMINI_MODEL=            # current Gemini Flash model id
SERPAPI_API_KEY=          # SerpApi key, or a SearchApi.io key (same Google Events engine)
SEARCHAPI_API_KEY=        # optional backup: SearchApi.io key, used only if the primary provider fails
EVENTS_PROVIDER=          # serpapi | searchapi (auto-detected from the key when empty)
SERPAPI_MONTHLY_QUOTA=250   # set to 100 if the SerpApi dashboard shows 100
RESEND_API_KEY=
ALERT_EMAIL=             # Karan's inbox (for the demo: the Resend account email)
EMAIL_FROM=onboarding@resend.dev
CRON_SECRET=             # long random string; required on every /api/cron/* call
APP_URL=                 # https://<project>.vercel.app
EMAIL_DRY_RUN=false      # true = log emails instead of sending
